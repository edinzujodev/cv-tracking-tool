{
  "manifest_version": 3,
  "name": "LinkedIn Resume",
  "version": "0.1.0",
  "description": "Turn your own LinkedIn profile into an ATS-friendly resume. Everything stays in your browser.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/in/*"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "LinkedIn Resume" },
  "side_panel": { "default_path": "src/panel.html" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["src/scanner.js"],
      "run_at": "document_idle"
    }
  ]
}
